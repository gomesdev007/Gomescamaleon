-- Função para verificar se player é bot
local function isBot(player)
    if not ignoreBotsEnabled then return false end
    return player.Name:match("Bot") or player.Name:match("NPC") or player.Name:match("bot")
end

-- Tabela para armazenar ESP boxes
local espBoxes = {}

-- Função para desenhar ESP Box
local function createEspBox(character)
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local boxId = "box_" .. character.Name
    if espBoxes[boxId] then return end
    
    local box = {}
    box.lines = {}
    
    for i = 1, 4 do
        box.lines[i] = Drawing.new("Line")
        box.lines[i].Color = accentColor
        box.lines[i].Thickness = boxSize
        box.lines[i].Visible = false
    end
    
    espBoxes[boxId] = {character = character, box = box}
end

-- Atualizar ESP Boxes
RunService.RenderStepped:Connect(function()
    -- Limpar boxes inativas
    for boxId, data in pairs(espBoxes) do
        if not data.character or not data.character.Parent then
            for _, line in ipairs(data.box.lines) do
                line:Remove()
            end
            espBoxes[boxId] = nil
        end
    end
    
    -- Atualizar boxes ativas
    if espEnabled then
        for _, otherPlayer in pairs(Players:GetPlayers()) do
            if otherPlayer ~= player and otherPlayer.Character then
                if not isBot(otherPlayer) then
                    createEspBox(otherPlayer.Character)
                end
            end
        end
        
        for boxId, data in pairs(espBoxes) do
            if data.character and data.character:FindFirstChild("HumanoidRootPart") then
                local hrp = data.character.HumanoidRootPart
                local humanoid = data.character:FindFirstChild("Humanoid")
                
                if humanoid and humanoid.Health > 0 then
                    local camera = workspace.CurrentCamera
                    local headPos = data.character:FindFirstChild("Head")
                    if not headPos then return end
                    
                    local headScreen = camera:WorldToScreenPoint(headPos.Position)
                    local feetScreen = camera:WorldToScreenPoint(hrp.Position + Vector3.new(0, -hrp.Size.Y/2, 0))
                    
                    local topY = headScreen.Y
                    local bottomY = feetScreen.Y
                    local height = bottomY - topY
                    local width = height * 0.5
                    local centerX = headScreen.X
                    
                    local topLeft = Vector2.new(centerX - width/2, topY)
                    local topRight = Vector2.new(centerX + width/2, topY)
                    local bottomLeft = Vector2.new(centerX - width/2, bottomY)
                    local bottomRight = Vector2.new(centerX + width/2, bottomY)
                    
                    if headScreen.Z > 0 then
                        data.box.lines[1].From = topLeft
                        data.box.lines[1].To = topRight
                        data.box.lines[1].Visible = true
                        data.box.lines[1].Thickness = boxSize
                        
                        data.box.lines[2].From = topRight
                        data.box.lines[2].To = bottomRight
                        data.box.lines[2].Visible = true
                        data.box.lines[2].Thickness = boxSize
                        
                        data.box.lines[3].From = bottomRight
                        data.box.lines[3].To = bottomLeft
                        data.box.lines[3].Visible = true
                        data.box.lines[3].Thickness = boxSize
                        
                        data.box.lines[4].From = bottomLeft
                        data.box.lines[4].To = topLeft
                        data.box.lines[4].Visible = true
                        data.box.lines[4].Thickness = boxSize
                    else
                        for _, line in ipairs(data.box.lines) do
                            line.Visible = false
                        end
                    end
                else
                    for _, line in ipairs(data.box.lines) do
                        line.Visible = false
                    end
                end
            end
        end
    else
        for _, data in pairs(espBoxes) do
            for _, line in ipairs(data.box.lines) do
                line.Visible = false
            end
        end
    end
end)

-- Aimbot melhorado com suavidade
local currentTarget = nil
local targetLockTime = 0

local function getClosestPlayerInFOV()
    local closest = nil
    local closestDistance = fovSize
    
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character then
            local humanoid = otherPlayer.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 and not isBot(otherPlayer) then
                local character = otherPlayer.Character
                if character:FindFirstChild("Head") then
                    local headPos = character.Head.Position
                    local screenPos, onScreen = Camera:WorldToScreenPoint(headPos)
                    
                    if onScreen then
                        local mousePos = mouse.Position
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        
                        if distance < closestDistance then
                            closestDistance = distance
                            closest = character.Head
                        end
                    end
                end
            end
        end
    end
    
    return closest
end

-- Aimbot Execution com suavidade e lock
RunService.RenderStepped:Connect(function()
    if aimbotEnabled then
        local target = getClosestPlayerInFOV()
        
        if target then
            currentTarget = target
            targetLockTime = 0
            
            local screenPos = Camera:WorldToScreenPoint(target.Position)
            local targetMousePos = Vector2.new(screenPos.X, screenPos.Y)
            
            -- Movimento suave em direção ao alvo
            local currentMousePos = mouse.Position
            local direction = (targetMousePos - currentMousePos).Unit
            local distance = (targetMousePos - currentMousePos).Magnitude
            local moveDistance = math.min(distance * smoothness, distance)
            
            local newX = currentMousePos.X + direction.X * moveDistance
            local newY = currentMousePos.Y + direction.Y * moveDistance
            
            -- Mover o mouse
            mouse.X = newX
            mouse.Y = newY
        else
            currentTarget = nil
            targetLockTime = targetLockTime + 1
        end
    end
end)

