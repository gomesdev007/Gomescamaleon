RunService.RenderStepped:Connect(function()
    if dragging then
        local delta = mouse.Position - dragStart
        mainPanel.Position = UDim2.new(
            panelStart.X.Scale, 
            panelStart.X.Offset + delta.X, 
            panelStart.Y.Scale, 
            panelStart.Y.Offset + delta.Y
        )
    end
end)

